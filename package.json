{
  "name": "warehouse-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run gen-api-docs:all && npm run gen-async-docs:all && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "gen-api-docs:all": "docusaurus gen-api-docs all",
    "clean-api-docs:all": "docusaurus clean-api-docs all",
    "gen-async-docs:all": "node scripts/gen-async-docs.mjs",
    "postinstall": "npm --prefix tools/asyncapi-gen install --no-audit --no-fund"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~5.7.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "description": "Fleet-wide documentation for the warehouse-systems ecosystem: strategic & tactical DDD artifacts, REST and AsyncAPI references, and business context for every bounded context.",
  "overrides": {
    "openapi-to-postmanv2": {
      "js-yaml": "^4.3.1"
    },
    "yaml": "^1.10.3",
    "uuid": "^11.1.1",
    "serialize-javascript": "^7.1.0",
    "webpack-dev-server": "^5.2.6",
    "sockjs": "^0.3.24"
  }
}
